*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#667eea,#764ba2);
}

.container{
    background:#fff;
    padding:40px;
    width:400px;
    border-radius:15px;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
    text-align:center;
    animation:fadeIn .5s ease;
}

.container h2{
    margin-bottom:25px;
    color:#333;
}

input{
    width:100%;
    padding:12px;
    margin:10px 0;
    border:1px solid #ddd;
    border-radius:8px;
    font-size:16px;
    transition:.3s;
}

input:focus{
    outline:none;
    border-color:#667eea;
    box-shadow:0 0 8px rgba(102,126,234,.3);
}

button{
    width:100%;
    padding:12px;
    margin-top:15px;
    border:none;
    border-radius:8px;
    background:#667eea;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#5563d6;
    transform:translateY(-2px);
}

a{
    color:#667eea;
    text-decoration:none;
    font-weight:600;
}

a:hover{
    text-decoration:underline;
}

.erro{
    color:red;
    margin-top:15px;
}

.sucesso{
    text-align:center;
}

.emoji{
    font-size:80px;
    margin-bottom:15px;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(-20px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}
